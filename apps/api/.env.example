# ============================================================================
# OPC API — Environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` (apps/api/.env) and fill in real values.
# NEVER commit a populated copy to git. Add entries here when introducing
# new env vars so contributors can see the full surface in one place.
# ============================================================================

# ---- HTTP server -----------------------------------------------------------
# Port the Go API binds to. Match the docker-compose port mapping.
PORT=8080

# Path to the SQLite database file. In containerized setups, the compose
# file mounts opc-data:/data so this default works out of the box.
DB_PATH=/data/opc.db

# ---- AI providers ----------------------------------------------------------
# All keys are optional. A missing key puts the corresponding provider in
# "demo mode" — the router reports it as Available()==false and falls back
# to canned demo data so the UI stays interactive without external calls.

# Anthropic / Claude. Required for: topic generation, script humanize,
# content scoring (haiku), platform adaptation, viral formula, postmortem.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# DeepSeek. Optional fallback for high-volume Chinese tasks (OpenAI-compatible
# chat completions). Get a key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Google Gemini. Required for video deconstruction (multimodal video
# understanding). Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Per-task model overrides without recompiling. Format:
#   AI_MODEL_OVERRIDES=task=model[,task=model...]
# Provider is inferred from the task default. To override the provider too,
# prefix the model with "provider:" e.g.
#   AI_MODEL_OVERRIDES=topic_generate=deepseek:deepseek-chat
# Valid task names: topic_generate, script_humanize, content_score,
#                   platform_adapt, deconstruct, viral_formula, postmortem
# Leave empty for the industry-tuned defaults (see agents.DefaultRoutes).
AI_MODEL_OVERRIDES=

# ---- Logging ---------------------------------------------------------------
# Standard log levels: debug, info, warn, error. Production should run
# `info` or `warn` to keep log volume manageable.
LOG_LEVEL=info

# Log handler: `text` for human-friendly dev output, `json` for production
# aggregation pipelines. Defaults to text when unset.
LOG_FORMAT=text

# ---- Auth ------------------------------------------------------------------
# ENCRYPTION_KEY is parsed by auth.MustLoadKey (internal/auth/crypto.go).
# It must decode to at least 32 raw bytes. We accept both standard
# base64 (the default, recommended for ops) and raw ASCII text.
# The dev default below is a public test key — DO NOT use in production.
# Generate your own with:  head -c 32 /dev/urandom | base64
#
# (Historical default "this-is-a-32-byte-test-key-for-opc!" was 35
# raw bytes. The loader falls back to raw bytes when base64 decode
# fails, so it happened to work — but the size assertion in the
# comment was wrong, and a developer who lengthens the key to
# "match" the comment could easily end up with 36+ bytes that the
# AES cipher would reject with "invalid key size 37". Replaced
# with an unambiguous 32-byte base64 value.)
ENCRYPTION_KEY=cGhhc2U0LXZlcmlmeS1lbmNyeXB0aW9uLTMyYnl0ZXM=

# POST /api/auth/register is OPEN by default. Set to 0 in production.
REGISTRATION_ENABLED=1

# Set to 1 to skip the Secure flag on the opc_session cookie. Use this for
# local HTTP development only — production runs behind HTTPS and should
# leave this unset so the cookie is Secure.
# OPC_INSECURE_COOKIES=

# ---- Cover image generation (Kling / 即梦) -------------------------------
# 火山引擎 OpenAPI access key for the cover-image generation endpoint.
# Without this key the /ai/cover handler returns a deterministic
# data:image/svg+xml placeholder (good enough for demos + CI). Get a
# key from https://console.volcengine.com/iam/accesskey and grant
# the "视觉智能" (cv) service permission to the AK/SK pair.
# VOLCENGINE_ACCESS_KEY=

# Provider selector for the cover endpoint. Allowed values:
#   kling  — 火山引擎 可灵 (default when a key is set)
#   jimeng — 火山引擎 即梦
#   auto   — pick the first configured provider (defaults to kling)
#   mock   — never hit the network, always return the SVG placeholder
# Unknown values fall back to "auto" so a typo does not 400 the call.
# COVER_PROVIDER=auto

# MiniMax — image / speech / video
# API key for the MiniMax multimodal provider (image / speech / video
# generation). Used by the /ai/cover endpoint when COVER_PROVIDER selects
# a MiniMax-backed path. Without this key the cover handler silently
# falls back to the deterministic SVG placeholder, so a missing value
# is non-fatal for demos but will surprise operators who expect real
# media. Get a key from the MiniMax platform (TBD; internal MiniMax
# platform — confirm with the AI infra team before pointing customers
# at a public URL).
# MINIMAX_API_KEY=
