{
  "name": "@opc/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TS code for the OPC frontend apps (web demo + console). Pure data and client-side helpers — no Node-only deps.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./types": "./src/types/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n-types": "./src/i18n/types.ts",
    "./i18n-client": "./src/i18n/client.ts",
    "./i18n-lookup": "./src/i18n/lookup.ts",
    "./i18n/locales/*": "./src/i18n/locales/*",
    "./utils": "./src/utils/index.ts",
    "./hooks": "./src/hooks/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "5.5.3",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
