# ============================================================================
# OPC — Production environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env.production` (or `.env` for `docker compose`) and
# fill in the real values. NEVER commit a populated copy to git.
#
#   cp .env.example .env.production
#   chmod 600 .env.production
# ============================================================================

# ---- Anthropic -------------------------------------------------------------
# Required. The Claude agent endpoint will refuse to complete without this.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# ---- DeepSeek (optional) ---------------------------------------------------
# Optional. High-volume Chinese fallback (OpenAI-compatible chat completions).
# Missing key puts DeepSeek in demo mode — the router degrades gracefully.
# Get a key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ---- Google Gemini (optional) ----------------------------------------------
# Optional. Required for video deconstruction (multimodal). Missing key
# routes deconstruction tasks to the fallback provider (Claude) instead.
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# ---- AI model overrides (optional) -----------------------------------------
# Pin a single OPC task to a non-default model without recompiling. Format:
#   AI_MODEL_OVERRIDES=task=model[,task=model...]
# Prefix the model with "provider:" to swap the provider too, e.g.
#   AI_MODEL_OVERRIDES=topic_generate=deepseek:deepseek-chat
# Leave empty for industry-tuned defaults.
AI_MODEL_OVERRIDES=

# ---- API server ------------------------------------------------------------
# Port the Go API binds to inside the container. The compose file already
# publishes this port to the host on 8080.
PORT=8080

# Path to the SQLite database file inside the `opc-data` volume mount.
# The Docker compose file mounts opc-data:/data, so this default works
# out of the box for the containerized setup.
DB_PATH=/data/opc.db

# Standard log levels: debug, info, warn, error. Production should run
# `info` or `warn` to keep log volume manageable.
LOG_LEVEL=info

# ---- Auth (Phase 2) -------------------------------------------------------
# Set to 1 / true / yes / on to allow self-service registration at
# /api/auth/register. The default is OFF: the first user must be
# seeded out-of-band (see docs/PHASE2-AUTH.md) and any later
# self-service flow is a deliberate flip of this knob per environment.
# REGISTRATION_ENABLED=

# Set to 1 to skip the Secure flag on the opc_session cookie. Use this
# for local HTTP development only — production runs behind HTTPS via
# nginx and should leave this unset so the cookie is Secure.
# OPC_INSECURE_COOKIES=

# ---- Web (Next.js) ---------------------------------------------------------
# The web container calls the API through this URL. When running behind the
# same nginx reverse proxy on the host, set this to the public origin so the
# browser can reach the API directly:
#   NEXT_PUBLIC_API_URL=https://opc.example.com
# For container-to-container traffic on the same host, the default
# http://api:8080 will work because of the internal `opc-net` network.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- Deploy (used by scripts/deploy.sh) ------------------------------------
# SSH target / SSH config alias for the production VPS.
VPS_HOST=opc-vps

# Remote deployment directory. Must match what you set up in
# /etc/systemd/system/opc-backup.service and your reverse-proxy config.
REMOTE_DIR=/opt/opc

# Optional. If you set a registry, deploy.sh will `docker push` instead of
# streaming `docker save | docker load` over SSH. Leave blank to use the
# save/load path (no registry required).
# PUSH_REGISTRY=ghcr.io/your-org/opc

# ---- Backup (used by scripts/backup.sh) ------------------------------------
# Where compressed SQLite backups are written. The compose file mounts the
# opc-backups volume at /backups inside the api container; if you run
# backup.sh on the host (recommended), point this at a host path that
# bind-mounts the same volume.
BACKUP_DIR=/backups

# How many days of backups to retain.
RETENTION_DAYS=7

# Set to 1 to use the atomic `sqlite3 .backup` snapshot (requires the
# sqlite3 CLI on the host). Leave empty for a plain `cp` fallback.
# USE_SQLITE3=1

# ---- Healthcheck (used by scripts/healthcheck.sh) --------------------------
# URL the healthcheck script probes. Defaults to localhost:8080 which is
# correct when the script runs on the same host as the API.
HEALTH_URL=http://localhost:8080/health

# ---- opc-asset CLI (user-configurable text provider) -----------------------
# The opc-asset CLI is single-user (no credential table lookup), so the
# text provider is configured via env vars. Pick a protocol and supply
# an API key; base URL + model are optional and fall back to provider
# defaults.
# OPC_ASSET_PROVIDER=anthropic  # or "openai"
# OPC_ASSET_API_KEY=sk-...
# OPC_ASSET_BASE_URL=https://api.anthropic.com  # optional
# OPC_ASSET_MODEL=claude-sonnet-4-5
# ANTHROPIC_AUTH_TOKEN=...  # legacy alias for OPC_ASSET_API_KEY
