#!/usr/bin/env python3
"""vivify shell entry — installed to scripts/ directory.

Usage:
    ./scripts/vivify character list
    ./scripts/vivify episode list
"""

import sys
from pathlib import Path

# Add project root to sys.path so `vivify` package can be imported
ROOT = Path(__file__).parent.parent
sys.path.insert(0, str(ROOT))

from vivify.cli import main  # noqa: E402

if __name__ == "__main__":
    main(obj={})