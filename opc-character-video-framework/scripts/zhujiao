#!/usr/bin/env python3
"""zhujiao shell entry — installed to scripts/ directory.

Usage:
    ./scripts/zhujiao character list
    ./scripts/zhujiao episode list
"""

import sys
from pathlib import Path

# Add project root to sys.path so `zhujiao` package can be imported
ROOT = Path(__file__).parent.parent
sys.path.insert(0, str(ROOT))

from zhujiao.cli import main  # noqa: E402

if __name__ == "__main__":
    main(obj={})